# Copy this file to .env.local and fill in your own credentials.
# NEVER commit real credentials. `.env.example` must contain placeholders only.

# Google Gemini is the single model backend for the chat route.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Recommendation data sources (keep these server-side; never prefix with NEXT_PUBLIC_).
GOOGLE_PLACES_API_KEY=
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
